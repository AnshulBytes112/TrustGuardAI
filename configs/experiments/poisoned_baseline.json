{
  "experiment_name": "poisoned-baseline",
  "dataset": {
    "type": "jsonl",
    "path": "tests/fixtures/synthetic.jsonl",
    "configuration": {
      "dataset_id": "synthetic",
      "dataset_version": "v1",
      "text_field": "text",
      "label_field": "label",
      "split_field": "split"
